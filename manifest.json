{
  "manifest_version": 3,
  "name": "HJX Extension",
  "version": "2.12",
  "description": "Block or filter specific content on ACG-related websites.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "tabs",
    "unlimitedStorage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.zhihu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.wnacg.com/*",
    "https://jmcomic-zzz.one/*",
    "https://chunman4.com/*",
    "https://gemini.google.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://missav123.com/*",
    "https://missav.live/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: https://t2.gstatic.com;"
  },
  "default_locale": "en",
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-pin": {
      "suggested_key": {
        "default": "Ctrl+Shift+P"
      },
      "description": "Toggle pin/unpin active tab"
    },
    "display-onetab": {
      "description": "__MSG_displayOneTab__",
      "suggested_key": {
        "default": "Alt+Shift+1"
      }
    },
    "send-current-tab-to-onetab": {
      "description": "__MSG_sendCurrentTabToOneTab__"
    }
  },
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.zhihu.com/*",
        "https://*.xiaohongshu.com/*",
        "https://*.wnacg.com/*",
        "https://jmcomic-zzz.one/*",
        "https://chunman4.com/*"
      ],
      "js": ["config.js", "content.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": ["config.js", "ai_shortcuts.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://missav123.com/*", "https://missav.live/*"],
      "js": ["missav_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://missav123.com/*", "https://missav.live/*"],
      "js": ["css_injector.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["onetab.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
